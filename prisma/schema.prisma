generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

model Tier {
  id          String   @id @default(cuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products    AssignedProduct[]
  subscribers Subscriber[]
}

model AssignedProduct {
  id           String   @id @default(cuid())
  tierId       String
  tier         Tier     @relation(fields: [tierId], references: [id])
  sku          String
  productName  String
  forceInclude Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model PreferenceSubmission {
  id            String      @id @default(cuid())
  subscriberId  String?
  subscriber    Subscriber? @relation(fields: [subscriberId], references: [id])
  customerEmail String
  month         String
  size          String?
  style         String?
  notes         String?
  submittedAt   DateTime    @default(now())
}

model Settings {
  id                      String  @id @default(cuid())
  automationEnabled       Boolean @default(true)
  selectionDeadlineOffset Int     @default(7)
  autoSelectionOffset     Int     @default(2)
  orderCreationOffset     Int     @default(1)

  reminder14Days Boolean @default(true)
  reminder7Days  Boolean @default(true)
  reminder3Days  Boolean @default(true)
  reminder1Day   Boolean @default(true)

  senderEmail String?

  hideOutOfStock   Boolean @default(true)
  hideDiscontinued Boolean @default(true)
  allowBackorders  Boolean @default(false)

  autoCreateOrders    Boolean @default(true)
  requireManualReview Boolean @default(false)

  autoOrderTag        String? @default("SubscriptionSync-Auto")
  customerSelectedTag String? @default("MonthlySelection")
  modifiedOrderTag    String? @default("AppstleSync")

  updatedAt DateTime @updatedAt
}

model Subscriber {
  id    String @id @default(cuid())
  name  String
  email String

  // External system references
  shopifyCustomerId     String?
  appstleSubscriptionId String? @unique
  appstlePlanId         String?
  appstlePlanName       String?

  // Appstle-owned subscription data
  subscriptionStatus    String    @default("Active")
  subscriptionStartDate DateTime
  nextOrderDate         DateTime?

  // SubscriptionSync-owned workflow data
  workflowStatus        String    @default("Waiting for Selection")
  nextShipDate          DateTime
  nextSelectionDeadline DateTime
  autoSelectionDate     DateTime?
  selectionEmailSentAt  DateTime?
  selectionSubmittedAt  DateTime?

  // Legacy tier relationship
  tierId String?
  tier   Tier?   @relation(fields: [tierId], references: [id])

  // New fulfillment profile relationship
  fulfillmentProfileId String?
  fulfillmentProfile   FulfillmentProfile? @relation(fields: [fulfillmentProfileId], references: [id])

  shipments             Shipment[]
  preferenceSubmissions PreferenceSubmission[]
  selections            Selection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Shipment {
  id           String     @id @default(cuid())
  subscriberId String
  subscriber   Subscriber @relation(fields: [subscriberId], references: [id])
  shipDate     DateTime
  status       String     @default("Pending")
  productName  String?
  trackingUrl  String?
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Selection {
  id           String     @id @default(cuid())
  subscriberId String
  subscriber   Subscriber @relation(fields: [subscriberId], references: [id])
  month        String
  status       String     @default("Pending")
  productName  String?
  source       String     @default("Customer Form")
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model ActivityLog {
  id          String   @id @default(cuid())
  eventType   String
  description String
  status      String   @default("Success")
  user        String   @default("System")
  source      String   @default("SubscriptionSync")
  createdAt   DateTime @default(now())
}

model FulfillmentProfile {
  id          String  @id @default(cuid())
  name        String
  description String?
  isActive    Boolean @default(true)

  // Linked Appstle subscription plan
  appstlePlanId   String?
  appstlePlanName String?
  appstlePlanType String?

  // Selection window
  selectionOpenOffset     Int @default(14)
  selectionDeadlineOffset Int @default(7)

  // Reminder schedule
  reminder14Days Boolean @default(true)
  reminder7Days  Boolean @default(true)
  reminder3Days  Boolean @default(true)
  reminder1Day   Boolean @default(true)

  // Auto-selection
  autoSelectEnabled Boolean @default(true)
  autoSelectOffset  Int     @default(2)
  autoSelectRules   Json?

  // Inventory
  hideOutOfStock        Boolean @default(true)
  allowBackorders       Boolean @default(false)
  requireInventoryCheck Boolean @default(true)

  // Selection email
  emailSubject  String?
  emailTemplate String?

  // Relationships
  products    FulfillmentProduct[]
  subscribers Subscriber[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FulfillmentProduct {
  id                   String             @id @default(cuid())
  fulfillmentProfileId String
  fulfillmentProfile   FulfillmentProfile @relation(fields: [fulfillmentProfileId], references: [id], onDelete: Cascade)

  shopifyProductId String?
  productName      String
  sku              String?

  forceInclude Boolean @default(false)
  isActive     Boolean @default(true)

  variants FulfillmentVariant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FulfillmentVariant {
  id                   String             @id @default(cuid())
  fulfillmentProductId String
  fulfillmentProduct   FulfillmentProduct @relation(fields: [fulfillmentProductId], references: [id], onDelete: Cascade)

  shopifyVariantId String?
  variantName      String
  sku              String?
  size             String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// REUSABLE PRODUCT CATALOG
// ============================================================
//
// These models hold product and variant data imported from the
// Little Adventures Shopify product export.
//
// Products in this catalog are NOT automatically assigned to a
// Fulfillment Profile. They become the searchable pool of products
// the Little Adventures team can choose from when configuring a
// profile.
//
// Later, this catalog can be synchronized directly from Shopify
// instead of being populated from a CSV.
// ============================================================

model CatalogProduct {
  id String @id @default(cuid())

  // Shopify references
  shopifyProductId String?
  handle           String?

  // Product information
  productName String
  category    String?
  productType String?
  vendor      String?

  // Product state
  isActive Boolean @default(true)

  // Relationships
  variants CatalogVariant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([productType])
  @@index([productName])
}

model CatalogVariant {
  id String @id @default(cuid())

  catalogProductId String
  catalogProduct   CatalogProduct @relation(fields: [catalogProductId], references: [id], onDelete: Cascade)

  // Shopify references
  shopifyVariantId String?

  // Variant information
  variantName String
  sku         String?
  size        String?

  // Inventory data copied from the Shopify export
  inventoryQty Int?

  // Variant state
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sku])
  @@index([size])
}
